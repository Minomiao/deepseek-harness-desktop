{
  "name": "dsh-desktop",
  "version": "0.1.0",
  "description": "DeepSeek Harness 桌面壳（Electron）：拉起本地 dsh web 服务并以窗口承载浏览器 UI",
  "main": "src/main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder"
  },
  "dependencies": {
    "@deepseek-ai/dsh": "0.1.0-rc.6"
  },
  "devDependencies": {
    "electron": "^35.0.0",
    "electron-builder": "^26.0.0"
  },
  "build": {
    "appId": "com.deepseek.dshdesktop",
    "productName": "DSH Desktop",
    "files": [
      "src/**/*",
      "build/icon.ico",
      "package.json"
    ],
    "icon": "build/icon.ico",
    "asar": true,
    "npmRebuild": false,
    "mac": {
      "target": ["dmg", "zip"],
      "category": "public.app-category.developer-tools"
    },
    "win": {
      "target": ["nsis", "portable"]
    },
    "linux": {
      "target": ["AppImage"],
      "category": "Development"
    }
  }
}
